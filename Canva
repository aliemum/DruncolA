    .dialog-copy h2{font-size:36px;margin:13px 0}
    .dialog-copy p{line-height:1.75;color:#65665e;margin:0 0 18px}
    .dialog-price{font-family:"DM Sans",sans-serif;font-size:22px;font-weight:700}
