    .purchase-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:9px}.purchase-actions button{border:1px solid var(--ink);border-radius:100px;padding:8px 12px;background:transparent;color:var(--ink);font-size:12px;font-weight:700}.purchase-actions button:hover{background:var(--ink);color:white}.purchase-actions .buy-btn{background:var(--coral);border-color:var(--coral);color:white}.purchase-actions .buy-btn:hover{background:#bf533b;border-color:#bf533b}
