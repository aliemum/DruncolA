  </footer><dialog id="product-dialog" aria-labelledby="dialog-title">
   <div class="dialog-layout">
    <img id="dialog-image" class="canva-image" src="https://images.pexels.com/photos/14330770/pexels-photo-14330770.jpeg" alt="Fashionable woman in beige trench coat and boots in an urban setting, exuding modern style." loading="lazy">
    <div class="dialog-copy">
     <button id="dialog-close" class="dialog-close canva-button" type="button" aria-label="বিস্তারিত বন্ধ করুন"><i data-lucide="x"></i></button>
     <div id="dialog-category" class="section-kicker canva-text"></div>
     <h2 id="dialog-title"></h2>
     <p id="dialog-description" class="canva-text"></p><strong id="dialog-price" class="dialog-price"></strong>
     <div class="purchase-actions">
      <button type="button" class="canva-button" id="dialog-add">কার্টে যোগ করুন</button><button type="button" class="buy-btn canva-button" id="dialog-buy">সরাসরি কিনুন</button>
     </div>
    </div>
