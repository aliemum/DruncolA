  <style>
    :root{--ink:#22231f;--muted:#77766f;--cream:#f8f6f0;--paper:#fffefa;--line:#e9e5dc;--coral:#e46b51;--sage:#dce4d9}
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;background:var(--cream);color:var(--ink);font-family:"Hind Siliguri",sans-serif}
    button,input{font-family:"Hind Siliguri",sans-serif}
    button,a{-webkit-tap-highlight-color:transparent}
    a{color:inherit;text-decoration:none}
    button{cursor:pointer}
    :focus-visible{outline:3px solid var(--coral);outline-offset:4px}
    .shell{max-width:1360px;margin:auto;padding-left:5.2%;padding-right:5.2%}
    .announcement{background:var(--ink);color:#fff;text-align:center;padding:9px 16px;font-size:13px;letter-spacing:.03em}
    .site-header{background:var(--cream);position:relative;z-index:10}
    .header-inner{display:flex;align-items:center;justify-content:space-between;min-height:83px;gap:20px}
    .brand{font-family:"DM Sans",sans-serif;font-size:29px;font-weight:700;letter-spacing:-.085em;white-space:nowrap}
    .brand span{color:var(--coral)}
    .nav{display:flex;align-items:center;gap:35px;font-size:14px;font-weight:600}
    .nav a:hover,.footer-links a:hover{color:var(--coral)}
    .header-action{display:inline-flex;align-items:center;gap:9px;border:1px solid var(--ink);border-radius:100px;padding:10px 18px;font-size:13px;font-weight:700;white-space:nowrap}
    .header-action:hover{background:var(--ink);color:white}
    .menu-toggle{display:none;background:none;border:0;padding:8px}
    .hero{padding-top:18px}
    .hero-grid{min-height:565px;display:grid;grid-template-columns:1.04fr .96fr;background:#ece9df;border-radius:20px;overflow:hidden}
    .hero-copy{padding:65px 7% 55px 9%;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;position:relative}
    .eyebrow{font-family:"DM Sans",sans-serif;text-transform:uppercase;letter-spacing:.19em;font-size:11px;font-weight:700;color:var(--coral);display:flex;align-items:center;gap:12px}
    .eyebrow:before{content:"";width:25px;height:1px;background:currentColor}
    h1{font-size:clamp(48px,6vw,88px);line-height:1.06;letter-spacing:-.055em;margin:25px 0 21px;font-weight:700;max-width:690px}
    h1 em{font-style:normal;color:var(--coral)}
    .hero-copy p{max-width:440px;font-size:17px;line-height:1.8;color:#5c5e57;margin:0 0 33px}
    .primary-btn{background:var(--ink);color:white;border:1px solid var(--ink);padding:15px 23px;border-radius:100px;display:inline-flex;align-items:center;gap:18px;font-size:15px;font-weight:700}
    .primary-btn:hover{background:var(--coral);border-color:var(--coral)}
    .primary-btn svg,.header-action svg{width:17px;height:17px}
    .hero-image-wrap{position:relative;min-height:500px;overflow:hidden}
    .hero-image-wrap img{width:100%;height:100%;display:block;object-fit:cover;object-position:center}
    .hero-sticker{position:absolute;left:-1px;bottom:35px;background:var(--paper);padding:16px 22px 13px;border-radius:0 12px 12px 0;box-shadow:0 8px 30px #00000012}
    .hero-sticker strong{display:block;font-family:"DM Sans",sans-serif;font-size:20px;letter-spacing:-.04em}
    .hero-sticker small{color:var(--muted);font-size:12px}
    section{scroll-margin-top:25px}
    .section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:27px}
    .section-kicker{color:var(--coral);font-family:"DM Sans",sans-serif;text-transform:uppercase;letter-spacing:.17em;font-size:11px;font-weight:700}
    h2{font-size:clamp(34px,4vw,54px);letter-spacing:-.055em;line-height:1.15;margin:9px 0 0}
    .section-note{font-size:15px;color:var(--muted);max-width:335px;line-height:1.6;margin:0}
    .collections{padding-top:92px;padding-bottom:92px}
    .category-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
    .category-card{border:0;padding:0;text-align:left;background:#e7e3dc;position:relative;height:405px;border-radius:15px;overflow:hidden;color:#fff}
    .category-card img{height:100%;width:100%;object-fit:cover;display:block;transition:transform .45s}
    .category-card:hover img{transform:scale(1.055)}
    .category-card:after{content:"";position:absolute;inset:35% 0 0;background:linear-gradient(transparent,#151610b8)}
    .category-content{position:absolute;z-index:1;left:26px;right:24px;bottom:24px;display:flex;align-items:end;justify-content:space-between;gap:8px}
    .category-content small{display:block;font-family:"DM Sans",sans-serif;font-size:11px;letter-spacing:.17em;text-transform:uppercase;margin-bottom:8px}
    .category-content strong{display:block;font-size:29px;line-height:1.1}
    .round-arrow{display:grid;place-items:center;background:#fff;color:var(--ink);width:42px;height:42px;border-radius:50%;flex:none}
    .round-arrow svg{width:18px;height:18px}
    .catalog-section{background:var(--paper);padding:88px 0 100px}
    .catalog-top{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:28px}
    .filters{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:29px}
    .filter-btn{border:1px solid #dedbd2;background:transparent;color:#565750;border-radius:100px;padding:10px 18px;font-size:13px;font-weight:700}
    .filter-btn:hover,.filter-btn.active{background:var(--ink);border-color:var(--ink);color:white}
    .product-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:19px}
    .product-card{min-width:0}
    .product-photo{height:320px;border-radius:13px;overflow:hidden;background:#ebe7df;position:relative}
    .product-photo img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s}
    .product-card:hover .product-photo img{transform:scale(1.05)}
    .product-tag{position:absolute;left:13px;top:13px;background:#fffefa;padding:6px 10px;border-radius:100px;font-size:11px;font-weight:700}
    .product-info{padding:15px 2px}
    .product-type{font-size:11px;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);font-family:"DM Sans",sans-serif}
    .product-info h3{font-size:19px;line-height:1.3;margin:5px 0 5px}
