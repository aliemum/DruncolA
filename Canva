  <script>
    const products = [
      {id:"urban",category:"everyday",categoryLabel:"Everyday Wear",name:"আরবান ইজ",price:"৳ ১,৮৫০",tag:"Everyday pick",description:"সহজ, স্মার্ট আর আরামদায়ক—ব্যস্ত দিনের জন্য অনুপ্রাণিত একটি অনায়াস স্টাইল।",image:"https://images.pexels.com/photos/14330770/pexels-photo-14330770.jpeg",alt:"Fashionable woman in beige trench coat and boots in an urban setting, exuding modern style."},
      {id:"heritage",category:"traditional",categoryLabel:"Traditional Wear",name:"রঙিন ঐতিহ্য",price:"৳ ৩,২৫০",tag:"Timeless",description:"রঙ ও ঐতিহ্যের মেলবন্ধনে বিশেষ দিনের সাজের অনুপ্রেরণা।",image:"https://images.pexels.com/photos/6786973/pexels-photo-6786973.jpeg",alt:"Group of women in vibrant Indian sarees posing against a colorful backdrop."},
      {id:"grace",category:"modest",categoryLabel:"Modest Wear",name:"গ্রেসফুল মোমেন্ট",price:"৳ ২,৭৫০",tag:"Modest edit",description:"মার্জিত সিলুয়েট ও স্বাচ্ছন্দ্যকে ঘিরে সাজানো একটি পরিশীলিত লুক।",image:"https://images.pexels.com/photos/29188563/pexels-photo-29188563.jpeg",alt:"Portrait of a woman in a brown abaya and hijab, elegantly posed indoors."},
      {id:"neutral",category:"everyday",categoryLabel:"Everyday Wear",name:"নিউট্রাল ডে",price:"৳ ১,৬৫০",tag:"Easy style",description:"নরম নিউট্রাল টোনে দৈনন্দিন পোশাকের সহজ ও বহুমুখী অনুপ্রেরণা।",image:"https://images.pexels.com/photos/16470015/pexels-photo-16470015.jpeg",alt:"Stylish beige coats neatly arranged on racks in a modern clothing store interior."}
    ];
    // নতুন বিভাগ বা ভবিষ্যতের গ্যাজেট যোগ করতে products-এ নতুন category-সহ আইটেম যোগ করুন,
    // তারপর filters-এ সেই category-র একটি বোতাম যুক্ত করুন।
    const grid=document.getElementById("product-grid");
    const dialog=document.getElementById("product-dialog");
    let lastTrigger=null;
    function renderProducts(category="all"){
      const selected=category==="all"?products:products.filter(item=>item.category===category);
      grid.innerHTML=selected.map(item=>`
        <article class="product-card canva-card">
          <div class="product-photo">
            <img id="product-image-${item.id}" class="canva-image" src="${item.image}" alt="${item.alt}" loading="lazy">
            <span class="product-tag canva-tag">${item.tag}</span>
          </div>
          <div class="product-info">
            <span class="product-type canva-text">${item.categoryLabel}</span>
            <h3>${item.name}</h3>
            <div class="product-row"><span class="price">${item.price}</span><button type="button" class="detail-btn canva-button" data-product="${item.id}" aria-label="${item.name} বিস্তারিত দেখুন">বিস্তারিত দেখুন ↗</button></div>
          </div>
        </article>`).join("");
    }
    function setFilter(category){
      document.querySelectorAll(".filter-btn").forEach(button=>{
        const active=button.dataset.filter===category;
        button.classList.toggle("active",active);
        button.setAttribute("aria-pressed",String(active));
      });
      renderProducts(category);
    }
    document.getElementById("filters").addEventListener("click",event=>{
      const button=event.target.closest("[data-filter]");
      if(button)setFilter(button.dataset.filter);
    });
    document.querySelectorAll(".category-card").forEach(button=>button.addEventListener("click",()=>{
      setFilter(button.dataset.category);
      document.getElementById("shop").scrollIntoView({behavior:"smooth"});
    }));
    grid.addEventListener("click",event=>{
      const button=event.target.closest("[data-product]");
      if(!button)return;
      const item=products.find(product=>product.id===button.dataset.product);
      if(!item)return;
      lastTrigger=button;
      const image=document.getElementById("dialog-image");
      image.src=item.image;image.alt=item.alt;
      document.getElementById("dialog-category").textContent=item.categoryLabel;
      document.getElementById("dialog-title").textContent=item.name;
      document.getElementById("dialog-description").textContent=item.description;
      document.getElementById("dialog-price").textContent=item.price;
      dialog.showModal();
    });
    document.getElementById("dialog-close").addEventListener("click",()=>dialog.close());
    dialog.addEventListener("click",event=>{if(event.target===dialog)dialog.close()});
    dialog.addEventListener("close",()=>lastTrigger?.focus());
    const menuButton=document.getElementById("menu-toggle");
    const nav=document.getElementById("main-nav");
    menuButton.addEventListener("click",()=>{
      const open=nav.classList.toggle("open");
      menuButton.setAttribute("aria-expanded",String(open));
      menuButton.setAttribute("aria-label",open?"মেনু বন্ধ করুন":"মেনু খুলুন");
    });
    nav.querySelectorAll("a").forEach(link=>link.addEventListener("click",()=>{
      nav.classList.remove("open");
      menuButton.setAttribute("aria-expanded","false");
      menuButton.setAttribute("aria-label","মেনু খুলুন");
    }));
    renderProducts();
    lucide.createIcons();
  </script>
