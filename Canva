  <title>DruncolA — প্রতিদিনের স্টাইল, নিজের মতো</title>
  <meta name="description" content="DruncolA-তে আবিষ্কার করুন everyday, traditional ও modest wear-এর বাছাই করা স্টাইল।">
  <link rel="preconnect" href="https://fonts.googleapis.com">
