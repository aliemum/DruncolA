  </dialog> <button id="cart-trigger" class="cart-trigger canva-button" type="button" aria-label="কার্ট খুলুন"><i data-lucide="shopping-bag"></i> কার্ট <span id="cart-count">০</span></button> <dialog id="cart-dialog" class="cart-dialog canva-panel" aria-labelledby="cart-title">
   <button id="cart-close" class="dialog-close canva-button" type="button" aria-label="কার্ট বন্ধ করুন"><i data-lucide="x"></i></button>
   <h2 id="cart-title">আপনার কার্ট</h2>
   <div id="cart-items" class="canva-list"></div>
   <div class="cart-total">
    <span>সাবটোটাল</span><span id="cart-subtotal">৳ ০</span>
   </div>
   <div class="cart-total">
    <span>মোট</span><span id="cart-total">৳ ০</span>
   </div>
   <button id="cart-checkout" class="primary-btn cart-checkout canva-button" type="button">চেকআউট দেখুন</button>
  </dialog> <dialog id="checkout-dialog" class="cart-dialog canva-panel" aria-labelledby="checkout-title">
   <button id="checkout-close" class="dialog-close canva-button" type="button" aria-label="চেকআউট বন্ধ করুন"><i data-lucide="x"></i></button>
   <h2 id="checkout-title">চেকআউট</h2>
   <div id="checkout-items" class="checkout-summary"></div>
   <div class="cart-total">
    <span>সাবটোটাল</span><span id="checkout-subtotal"></span>
   </div>
   <div class="cart-total">
    <span>মোট</span><span id="checkout-total"></span>
   </div>
   <form id="customer-order-form" class="customer-order-form">
    <h3>ডেলিভারির তথ্য</h3>
    <label for="customer-name">আপনার নাম</label>
    <input id="customer-name" name="customerName" type="text" placeholder="সম্পূর্ণ নাম লিখুন" autocomplete="name" required>
    <label for="customer-phone">মোবাইল নম্বর</label>
    <input id="customer-phone" name="customerPhone" type="tel" placeholder="01XXXXXXXXX" inputmode="tel" pattern="01[3-9][0-9]{8}" autocomplete="tel" required>
    <label for="customer-address">সম্পূর্ণ ঠিকানা</label>
    <textarea id="customer-address" name="customerAddress" rows="3" placeholder="বাসা/রোড, এলাকা, থানা, জেলা" autocomplete="street-address" required></textarea>
    <h3>পেমেন্ট পদ্ধতি</h3>
    <label class="payment-option"><input type="radio" name="paymentMethod" value="Cash on Delivery" checked> ক্যাশ অন ডেলিভারি (পণ্য হাতে পেয়ে পেমেন্ট)</label>
    <label class="payment-option"><input type="radio" name="paymentMethod" value="bKash"> bKash</label>
    <label class="payment-option"><input type="radio" name="paymentMethod" value="Nagad"> Nagad</label>
    <div id="mobile-payment-info" class="mobile-payment-info" hidden>
     <p>আপনার পছন্দের মোবাইল পেমেন্ট সার্ভিস নির্বাচন করা হয়েছে। পেমেন্ট নম্বর ও অনলাইন পেমেন্ট যাচাই চালু করতে দোকানের bKash/Nagad মার্চেন্ট বা পার্সোনাল নম্বর এবং পেমেন্ট গেটওয়ে যুক্ত করতে হবে।</p>
     <label for="payment-transaction">Transaction ID (পেমেন্ট করে থাকলে)</label>
     <input id="payment-transaction" name="transactionId" type="text" placeholder="Transaction ID লিখুন">
    </div>
    <p class="checkout-note">এটি বর্তমানে একটি ফ্রন্টএন্ড ডেমো। অর্ডারটি সার্ভারে সংরক্ষণ বা পেমেন্ট গ্রহণ হবে না, যতক্ষণ না WhatsApp/অর্ডার ব্যাকএন্ড ও পেমেন্ট গেটওয়ে যুক্ত করা হয়।</p>
    <button class="primary-btn cart-checkout canva-button" type="submit">অর্ডার নিশ্চিত করুন</button>
   </form>
   <button id="checkout-back" class="checkout-back canva-button" type="button">কার্টে ফিরে যান</button>
   <div id="order-confirmation" class="order-confirmation" role="status" hidden></div>
  </dialog>
  <script>
    const products = [
      {id:"urban",category:"everyday",categoryLabel:"Everyday Wear",name:"আরবান ইজ",price:"৳ ১,৮৫০",tag:"Everyday pick",description:"সহজ, স্মার্ট আর আরামদায়ক—ব্যস্ত দিনের জন্য অনুপ্রাণিত একটি অনায়াস স্টাইল।",image:"https://images.pexels.com/photos/14330770/pexels-photo-14330770.jpeg",alt:"Fashionable woman in beige trench coat and boots in an urban setting, exuding modern style."},
      {id:"heritage",category:"traditional",categoryLabel:"Traditional Wear",name:"রঙিন ঐতিহ্য",price:"৳ ৩,২৫০",tag:"Timeless",description:"রঙ ও ঐতিহ্যের মেলবন্ধনে বিশেষ দিনের সাজের অনুপ্রেরণা।",image:"https://images.pexels.com/photos/6786973/pexels-photo-6786973.jpeg",alt:"Group of women in vibrant Indian sarees posing against a colorful backdrop."},
      {id:"grace",category:"modest",categoryLabel:"Modest Wear",name:"গ্রেসফুল মোমেন্ট",price:"৳ ২,৭৫০",tag:"Modest edit",description:"মার্জিত সিলুয়েট ও স্বাচ্ছন্দ্যকে ঘিরে সাজানো একটি পরিশীলিত লুক।",image:"https://images.pexels.com/photos/29188563/pexels-photo-29188563.jpeg",alt:"Portrait of a woman in a brown abaya and hijab, elegantly posed indoors."},
      {id:"neutral",category:"everyday",categoryLabel:"Everyday Wear",name:"নিউট্রাল ডে",price:"৳ ১,৬৫০",tag:"Easy style",description:"নরম নিউট্রাল টোনে দৈনন্দিন পোশাকের সহজ ও বহুমুখী অনুপ্রেরণা।",image:"https://images.pexels.com/photos/16470015/pexels-photo-16470015.jpeg",alt:"Stylish beige coats neatly arranged on racks in a modern clothing store interior."}
    ];
    // নতুন বিভাগ বা ভবিষ্যতের গ্যাজেট যোগ করতে products-এ নতুন category-সহ আইটেম যোগ করুন,
    // তারপর filters-এ সেই category-র একটি বোতাম যুক্ত করুন।
    const grid=document.getElementById("product-grid");
    const dialog=document.getElementById("product-dialog");
    let lastTrigger=null;
    function renderProducts(category="all"){
      const selected=category==="all"?products:products.filter(item=>item.category===category);
      grid.innerHTML=selected.map(item=>`
        <article class="product-card canva-card">
          <div class="product-photo">
            <img id="product-image-${item.id}" class="canva-image" src="${item.image}" alt="${item.alt}" loading="lazy">
            <span class="product-tag canva-tag">${item.tag}</span>
          </div>
          <div class="product-info">
            <span class="product-type canva-text">${item.categoryLabel}</span>
            <h3>${item.name}</h3>
            <div class="product-row"><span class="price">${item.price}</span><button type="button" class="detail-btn canva-button" data-product="${item.id}" aria-label="${item.name} বিস্তারিত দেখুন">বিস্তারিত দেখুন ↗</button></div>
            <div class="purchase-actions"><button type="button" class="canva-button" data-add="${item.id}" aria-label="${item.name} কার্টে যোগ করুন">কার্টে যোগ করুন</button><button type="button" class="buy-btn canva-button" data-buy="${item.id}" aria-label="${item.name} সরাসরি কিনুন">সরাসরি কিনুন</button></div>
          </div>
        </article>`).join("");
    }
    function setFilter(category){
      document.querySelectorAll(".filter-btn").forEach(button=>{
        const active=button.dataset.filter===category;
        button.classList.toggle("active",active);
        button.setAttribute("aria-pressed",String(active));
      });
      renderProducts(category);
    }
    document.getElementById("filters").addEventListener("click",event=>{
      const button=event.target.closest("[data-filter]");
      if(button)setFilter(button.dataset.filter);
    });
    document.querySelectorAll(".category-card").forEach(button=>button.addEventListener("click",()=>{
      setFilter(button.dataset.category);
      document.getElementById("shop").scrollIntoView({behavior:"smooth"});
    }));
    const cart={};
    const cartDialog=document.getElementById('cart-dialog');
    const checkoutDialog=document.getElementById('checkout-dialog');
    const money=n=>'৳ '+new Intl.NumberFormat('bn-BD').format(n);
    const amount=item=>Number(item.price.replace(/[^0-9০-৯]/g,'').replace(/[০-৯]/g,d=>'০১২৩৪৫৬৭৮৯'.indexOf(d)));
    let checkoutSelection=[];
    let activeProduct=null;
    function renderCart(){
      const entries=Object.entries(cart).filter(([,qty])=>qty>0);
      document.getElementById('cart-count').textContent=new Intl.NumberFormat('bn-BD').format(entries.reduce((sum,[,qty])=>sum+qty,0));
      document.getElementById('cart-items').innerHTML=entries.length?entries.map(([id,qty])=>{const item=products.find(p=>p.id===id);return `<div class="cart-item canva-card"><img id="cart-image-${id}" class="canva-image" src="${item.image}" alt="${item.alt}" loading="lazy"><div class="cart-item-info"><strong>${item.name}</strong><small>${money(amount(item))} × ${new Intl.NumberFormat('bn-BD').format(qty)} = ${money(amount(item)*qty)}</small><div class="quantity-actions"><button type="button" data-decrease="${id}" aria-label="${item.name} একটি কমান">−</button><span>${new Intl.NumberFormat('bn-BD').format(qty)}</span><button type="button" data-increase="${id}" aria-label="${item.name} একটি বাড়ান">+</button></div></div></div>`}).join(''):'<p class="cart-empty">কার্ট এখন খালি। পছন্দের স্টাইল যোগ করুন।</p>';
      const sum=entries.reduce((total,[id,qty])=>total+amount(products.find(p=>p.id===id))*qty,0);
      document.getElementById('cart-subtotal').textContent=money(sum);
      document.getElementById('cart-total').textContent=money(sum);
      document.getElementById('cart-checkout').disabled=!entries.length;
    }
    function addCart(id){cart[id]=(cart[id]||0)+1;renderCart();}
    function openCheckout(entries){
      checkoutSelection=entries;
      const sum=entries.reduce((total,[id,qty])=>total+amount(products.find(p=>p.id===id))*qty,0);
      document.getElementById('checkout-items').innerHTML=entries.map(([id,qty])=>{const item=products.find(p=>p.id===id);return `<p><span>${item.name} × ${new Intl.NumberFormat('bn-BD').format(qty)}</span><strong>${money(amount(item)*qty)}</strong></p>`}).join('');
      document.getElementById('checkout-subtotal').textContent=money(sum);
      document.getElementById('checkout-total').textContent=money(sum);
      orderForm.reset();
      mobilePaymentInfo.hidden=true;
      document.getElementById("order-confirmation").hidden=true;
      if(dialog.open)dialog.close();
      if(cartDialog.open)cartDialog.close();
      checkoutDialog.showModal();
    }
    document.getElementById('cart-trigger').addEventListener('click',()=>{renderCart();cartDialog.showModal()});
    document.getElementById('cart-close').addEventListener('click',()=>cartDialog.close());
    document.getElementById('checkout-close').addEventListener('click',()=>checkoutDialog.close());
    document.getElementById('cart-checkout').addEventListener('click',()=>openCheckout(Object.entries(cart).filter(([,qty])=>qty>0)));
    const orderForm=document.getElementById("customer-order-form");
    const mobilePaymentInfo=document.getElementById("mobile-payment-info");
    orderForm.querySelectorAll('input[name="paymentMethod"]').forEach(input=>input.addEventListener("change",()=>{
      mobilePaymentInfo.hidden=orderForm.querySelector('input[name="paymentMethod"]:checked').value==="Cash on Delivery";
    }));
    orderForm.addEventListener("submit",event=>{
      event.preventDefault();
      if(!orderForm.reportValidity())return;
      const customer=new FormData(orderForm);
      const selected=checkoutSelection.map(([id,qty])=>({item:products.find(p=>p.id===id),qty}));
      const total=selected.reduce((sum,row)=>sum+amount(row.item)*row.qty,0);
      const orderLines=selected.map(row=>`${row.item.name} × ${row.qty}`).join(", ");
      const confirmation=document.getElementById("order-confirmation");
      confirmation.hidden=false;
      confirmation.textContent=`ধন্যবাদ ${customer.get("customerName")}! আপনার অর্ডারের তথ্য এই পেজে প্রস্তুত হয়েছে। পণ্য: ${orderLines}। মোট: ${money(total)}। পেমেন্ট: ${customer.get("paymentMethod")}। মনে রাখবেন, এই ডেমো অর্ডারটি দোকানে পাঠায়নি বা পেমেন্ট নেয়নি।`;
      confirmation.scrollIntoView({behavior:"smooth",block:"nearest"});
    });
    document.getElementById('checkout-back').addEventListener('click',()=>{checkoutDialog.close();renderCart();cartDialog.showModal()});
    document.getElementById('cart-items').addEventListener('click',event=>{const plus=event.target.closest('[data-increase]'),minus=event.target.closest('[data-decrease]');if(plus)cart[plus.dataset.increase]++;if(minus)cart[minus.dataset.decrease]=Math.max(0,cart[minus.dataset.decrease]-1);if(plus||minus)renderCart()});
    document.getElementById('dialog-add').addEventListener('click',()=>{if(activeProduct){addCart(activeProduct);dialog.close();cartDialog.showModal()}});
    document.getElementById('dialog-buy').addEventListener('click',()=>{if(activeProduct)openCheckout([[activeProduct,1]])});
    grid.addEventListener('click',event=>{const add=event.target.closest('[data-add]'),buy=event.target.closest('[data-buy]');if(add){addCart(add.dataset.add);cartDialog.showModal();return}if(buy){openCheckout([[buy.dataset.buy,1]]);return}});
    grid.addEventListener("click",event=>{
      const button=event.target.closest("[data-product]");
      if(!button)return;
      const item=products.find(product=>product.id===button.dataset.product);
      if(!item)return;
      lastTrigger=button;
      activeProduct=item.id;
      const image=document.getElementById("dialog-image");
      image.src=item.image;image.alt=item.alt;
      document.getElementById("dialog-category").textContent=item.categoryLabel;
      document.getElementById("dialog-title").textContent=item.name;
      document.getElementById("dialog-description").textContent=item.description;
      document.getElementById("dialog-price").textContent=item.price;
      dialog.showModal();
    });
    document.getElementById("dialog-close").addEventListener("click",()=>dialog.close());
    dialog.addEventListener("click",event=>{if(event.target===dialog)dialog.close()});
    dialog.addEventListener("close",()=>lastTrigger?.focus());
    const menuButton=document.getElementById("menu-toggle");
    const nav=document.getElementById("main-nav");
    menuButton.addEventListener("click",()=>{
      const open=nav.classList.toggle("open");
      menuButton.setAttribute("aria-expanded",String(open));
      menuButton.setAttribute("aria-label",open?"মেনু বন্ধ করুন":"মেনু খুলুন");
    });
    nav.querySelectorAll("a").forEach(link=>link.addEventListener("click",()=>{
      nav.classList.remove("open");
      menuButton.setAttribute("aria-expanded","false");
      menuButton.setAttribute("aria-label","মেনু খুলুন");
    }));
    renderProducts();
    lucide.createIcons();
  </script>
 </body>
