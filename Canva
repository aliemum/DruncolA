    .customer-order-form{display:grid;gap:9px;margin-top:20px}.customer-order-form h3{font-size:19px;margin:15px 0 3px}.customer-order-form>label{font-size:14px;font-weight:600}.customer-order-form input:not([type=radio]),.customer-order-form textarea{width:100%;border:1px solid var(--line);border-radius:9px;background:#fff;padding:12px 13px;font:inherit;color:var(--ink)}.customer-order-form textarea{resize:vertical}.payment-option{display:flex;align-items:center;gap:9px;padding:10px 12px;border:1px solid var(--line);border-radius:9px;font-weight:500!important}.payment-option input{accent-color:var(--coral)}.mobile-payment-info{background:#f4f0e8;padding:13px;border-radius:10px;font-size:13px;line-height:1.6}.mobile-payment-info p{margin:0 0 10px}.order-confirmation{margin-top:14px;padding:13px;background:var(--sage);border-radius:10px;line-height:1.6}
